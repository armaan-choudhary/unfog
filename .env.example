# Copy to .env for local settings. Replace the local PostgreSQL placeholder only.
APP_ENV=development
READINESS_TIMEOUT_SECONDS=3
DATABASE_URL=postgresql+psycopg://unfog:change-me@localhost:5432/unfog
# Production requires all three OIDC settings. Algorithms are asymmetric only.
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_ALLOWED_ALGORITHMS=RS256
OIDC_JWKS_TIMEOUT_SECONDS=3
# Local-only auth: enable explicitly and provide a generated bearer secret/email.
UNFOG_DEV_AUTH_ENABLED=false
UNFOG_DEV_AUTH_TOKEN=
UNFOG_DEV_AUTH_EMAIL=
UNFOG_DEV_AUTH_SUBJECT=local-developer
REDIS_URL=redis://localhost:6379/0
WORKER_TASK_SOFT_TIME_LIMIT_SECONDS=240
WORKER_TASK_HARD_TIME_LIMIT_SECONDS=300
WORKER_MAX_RETRIES=3
WORKER_RETRY_BASE_DELAY_SECONDS=2
WORKER_RETRY_MAX_DELAY_SECONDS=60
# Gemini AI Configuration (optional: server-side only, offline fallbacks active if omitted)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
