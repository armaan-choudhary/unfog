# Copy to .env for local settings. Replace the local PostgreSQL placeholder only.
APP_ENV=development
READINESS_TIMEOUT_SECONDS=3
DATABASE_URL=postgresql+psycopg://unfog:change-me@localhost:5432/unfog
REDIS_URL=redis://localhost:6379/0
WORKER_TASK_SOFT_TIME_LIMIT_SECONDS=240
WORKER_TASK_HARD_TIME_LIMIT_SECONDS=300
WORKER_MAX_RETRIES=3
WORKER_RETRY_BASE_DELAY_SECONDS=2
WORKER_RETRY_MAX_DELAY_SECONDS=60
